{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "PYTHONPATH=.github/hooks python3 -m agentwf hook pre",
        "powershell": "$env:PYTHONPATH='.github/hooks'; python -m agentwf hook pre",
        "cwd": ".",
        "timeoutSec": 30
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "PYTHONPATH=.github/hooks python3 -m agentwf hook post",
        "powershell": "$env:PYTHONPATH='.github/hooks'; python -m agentwf hook post",
        "cwd": ".",
        "timeoutSec": 15
      }
    ],
    "postToolUseFailure": [
      {
        "type": "command",
        "bash": "PYTHONPATH=.github/hooks python3 -m agentwf hook post-failure",
        "powershell": "$env:PYTHONPATH='.github/hooks'; python -m agentwf hook post-failure",
        "cwd": ".",
        "timeoutSec": 15
      }
    ]
  }
}
